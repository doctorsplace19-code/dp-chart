# WorkOccMed is a STATIC site — it has no server-side runtime and therefore
# no server environment variables. There is nothing to put in a real .env to
# run or deploy it.
#
# The third-party keys below are currently HARD-CODED inline in the HTML/JS.
# They are listed here (names only, no values) so a developer can find them and,
# ideally, move them out of the source. Never commit real values.

# Google Maps JavaScript API key — used by find-a-location.html for the
# location search/map. MUST be restricted by HTTP referrer (*.workoccmed.com)
# in Google Cloud Console. Currently inline in find-a-location.html.
GOOGLE_MAPS_API_KEY=

# Google tag (gtag.js) measurement/container ID — in each page's <head>.
GOOGLE_TAG_ID=

# Google Ads conversion tag ID — in each page's <head> alongside gtag.
GOOGLE_ADS_TAG_ID=

# Base domain used for white-label partner subdomains (handled by the SEPARATE
# portal app, not this static site). Documented here for reference only.
# NEXT_PUBLIC_BASE_DOMAIN=workoccmed.com
